# Token del bot ottenuto da @BotFather
TELEGRAM_BOT_TOKEN=
# Chiave API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Opzionale: il tuo user id Telegram. Se vuoto, il primo utente che fa /start diventa il proprietario.
TELEGRAM_OWNER_ID=
# Modello Claude usato per ricerca e analisi CV
CLAUDE_MODEL=claude-opus-5-5
# Numero massimo di ricerche web per ogni giro (incide sui costi)
WEB_SEARCH_MAX_USES=8
# Numero massimo di pagine di annunci aperte per verificarli
WEB_FETCH_MAX_USES=10
# Integra le fonti strutturate con la ricerca web di Claude (true/false)
WEB_SEARCH_ENABLED=true
# Fonti opzionali con chiave gratuita: si attivano solo se compilate
# Adzuna: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
# Cambio usato per mostrare i costi in euro (i prezzi Anthropic sono in dollari)
USD_EUR_RATE=0.92
TIMEZONE=Europe/Rome
DB_PATH=data/fa_bot.sqlite3
